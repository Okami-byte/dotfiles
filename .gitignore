# Ignore .env files for secret and keyword caching
.env

# Ignore DS.Store Files
.DS_Store

# Ignore log files so that people can't read system Info
*.log

# Ignore mpv cache files
mpv/cache/

# Ignore herdr auto-generated cache files
herdr/release-notes.json

# Ignore herdr plugin installer temporary directories
herdr/plugins/.tmp-install-*/

# Ignore fish universal variables (can contain secrets like API keys)
fish/fish_variables

# Ignore superfile runtime state and config backups
superfile/*.bak-*
superfile/firstUseCheck
superfile/lastCheckVersion
superfile/toggleDotFile
superfile/toggleFooter
superfile/themeFileVersion
